{
  "name": "ai-tab-organizer",
  "description": "AI-powered browser tab organizer for Brave and Chrome",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:brave": "wxt -b brave",
    "build": "wxt build",
    "build:brave": "wxt build -b brave",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm compile && pnpm check:svelte && pnpm test && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
